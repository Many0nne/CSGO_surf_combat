return function(T, Loader)
	local Rules = Loader.new():require("src/client/systems/game/MenuSceneRules")

	T.describe("MenuSceneRules.damp", function()
		T.it("se rapproche de la cible sans la dépasser", function()
			T.expectEqual(Rules.damp(0, 10, 0.1, 5), 5)
			T.expectEqual(Rules.damp(0, 10, 1, 5), 10)
		end)
	end)

	T.describe("MenuSceneRules.aimAngles", function()
		T.it("regarde droit devant quand le curseur est centré, sans recul", function()
			local a = Rules.aimAngles(0, 0, 0)
			T.expectEqual(a.camYaw, -0)
			T.expectEqual(a.gunPitch, -0)
		end)

		T.it("tourne l'arme plus que la caméra et vers le curseur", function()
			local a = Rules.aimAngles(1, -1, 0)
			T.expectEqual(a.gunYaw < a.camYaw, true)
			T.expectEqual(a.gunYaw < 0, true)
			T.expectEqual(a.gunPitch > a.camPitch, true)
		end)

		T.it("relève la visée pendant le recul", function()
			T.expectEqual(Rules.aimAngles(0, 0, 1).gunPitch > 0, true)
		end)
	end)

	T.describe("MenuSceneRules.decayKick", function()
		T.it("revient à zéro et ne passe pas en négatif", function()
			T.expectEqual(Rules.decayKick(0, 1), 0)
			T.expectEqual(Rules.decayKick(1, Rules.KICK_TIME * 2), 0)
			T.expectEqual(Rules.decayKick(1, 0) == 1, true)
		end)
	end)

	T.describe("MenuSceneRules.bezier", function()
		T.it("part du premier point et finit au dernier", function()
			T.expectEqual(Rules.bezier(2, 8, 20, 0), 2)
			T.expectEqual(Rules.bezier(2, 8, 20, 1), 20)
		end)

		T.it("passe par le milieu pondéré à t = 0,5", function()
			T.expectEqual(Rules.bezier(0, 4, 8, 0.5), 4)
		end)
	end)

	T.describe("MenuSceneRules.isHit", function()
		T.it("touche dans le rayon, seuil inclus", function()
			T.expectEqual(Rules.isHit(100, 100, 100, 100, 50), true)
			T.expectEqual(Rules.isHit(100 + Rules.HIT_RADIUS, 100, 100, 100, 50), true)
		end)

		T.it("rate hors du rayon ou derrière la caméra", function()
			T.expectEqual(Rules.isHit(100 + Rules.HIT_RADIUS + 1, 100, 100, 100, 50), false)
			T.expectEqual(Rules.isHit(100, 100, 100, 100, -5), false)
		end)
	end)
end
