return function(T, Loader)
	T.describe("Loader:require hors du thread principal (#412)", function()
		T.it("lève une erreur explicite depuis une coroutine, sans bloquer", function()
			local loader = Loader.new()
			local co = coroutine.create(function()
				return pcall(function()
					loader:require("src/shared/MathRules")
				end)
			end)
			local resumed, ok, err = coroutine.resume(co)
			T.expect(resumed, "la coroutine ne doit pas planter")
			T.expect(coroutine.status(co) == "dead", "le require ne doit pas céder la main")
			T.expect(ok == false, "le require doit échouer")
			T.expect(string.find(tostring(err), "avant de lancer la coroutine", 1, true) ~= nil, tostring(err))
		end)

		T.it("fonctionne depuis le thread principal", function()
			local M = Loader.new():require("src/shared/MathRules")
			T.expect(type(M) == "table", "le module doit se charger")
		end)
	end)
end
